---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<p>&copy; {today.getFullYear()} Ffans. Tots els drets reservats.</p>
		<!-- Si vols les xarxes socials, descomenta-les i adapta els enllaços -->
		<!--
		<div class="social-links">
			<a href="#" target="_blank">
				<span class="sr-only">... </span>
				<svg ... ></svg>
			</a>
		</div>
		-->
	</div>
</footer>

<style>
	footer {
		background: rgba(0, 0, 0, 0.8);
		backdrop-filter: blur(8px);
		color: white;
		text-align: center;
		padding: 2rem 1rem;
		margin-top: auto;
		border-top: 1px solid rgba(255,255,255,0.1);
	}
	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
	}
	footer p {
		margin: 0;
		font-size: 0.9rem;
		opacity: 0.9;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 0.5rem;
	}
	.social-links a {
		color: white;
		opacity: 0.7;
		transition: opacity 0.2s;
	}
	.social-links a:hover {
		opacity: 1;
	}
</style>