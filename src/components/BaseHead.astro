---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	OG_IMAGE,
	OG_IMAGE_WIDTH,
	OG_IMAGE_HEIGHT,
} from '../consts';

interface Props {
	title: string;
	description?: string;
	/** Imatge de la pàgina: metadada d'Astro o ruta estàtica (p. ex. /og-default.png). */
	image?: ImageMetadata | string;
	lang?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description = SITE_DESCRIPTION, image, lang = 'ca' } = Astro.props;

// Si la imatge ve del content collection, `image.src` ja és la URL que serveix
// Astro. Si és una ruta estàtica (p. ex. /og-default.png), la fem absoluta.
const imageSrc = typeof image === 'string' ? image : image?.src;
const ogImageURL = new URL(imageSrc ?? OG_IMAGE, Astro.site);

// Si la imatge és una metadada d'Astro, sabem les seves mides reals; si no,
// les de la imatge per defecte.
const ogImageWidth =
	typeof image === 'object' && image?.width ? image.width : OG_IMAGE_WIDTH;
const ogImageHeight =
	typeof image === 'object' && image?.height ? image.height : OG_IMAGE_HEIGHT;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/fans.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${SITE_TITLE} (${lang})`}
	href={new URL(`${lang}/rss.xml`, Astro.site)}
/>
<!-- Eliminem la línia que injecta Astro.generator -->
<!-- <meta name="generator" content={Astro.generator} /> -->

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={lang} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:alt" content={SITE_TITLE} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
