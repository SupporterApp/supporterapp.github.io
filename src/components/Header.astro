---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

// Idiomes: l'actual (per defecte 'ca')
const currentLocale = Astro.currentLocale || 'ca';
const basePath = `/${currentLocale}`;

// Obtenim la ruta sense el prefix de l'idioma
const pathWithoutLocale = Astro.url.pathname.replace(/^\/[a-z]{2}/, '');
---

<header>
	<nav>
		<h2>
			<a href={basePath}>
			<img src="/fans.png" alt="Ffans" width="32" height="32" style="vertical-align: middle; margin-right: 0.5rem; border-radius: 50%;" />
			{SITE_TITLE}
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href={basePath}>Inici</HeaderLink>
			<HeaderLink href={`${basePath}/blog`}>Blog</HeaderLink>
			<HeaderLink href={`${basePath}/about`}>Sobre nosaltres</HeaderLink>

			<!-- Menú desplegable: Legal -->
			<div class="dropdown">
				<button class="dropbtn" aria-haspopup="true" aria-expanded="false">
					Legal ▾
				</button>
				<div class="dropdown-content" role="menu">
					<a href={`${basePath}/legal/privacyPolicy`} role="menuitem">Privacitat</a>
					<a href={`${basePath}/legal/legalNotice`} role="menuitem">Avís Legal</a>
					<a href={`${basePath}/legal/termsOfUse`} role="menuitem">Termes</a>
				</div>
			</div>

			<!-- Menú desplegable: Ajuda -->
			<div class="dropdown">
				<button class="dropbtn" aria-haspopup="true" aria-expanded="false">
					Ajuda ▾
				</button>
				<div class="dropdown-content" role="menu">
					<a href={`${basePath}/help/home_page`} role="menuitem">Inici</a>
					<a href={`${basePath}/help/attend_match`} role="menuitem">Assistència</a>
					<a href={`${basePath}/help/progress_page`} role="menuitem">Progrés</a>
				</div>
			</div>
		</div>

		<!-- Selector d'idioma amb banderes PNG -->
		<div class="lang-selector">
			<a href={`/ca${pathWithoutLocale}`} class:list={[{ active: currentLocale === 'ca' }]} title="Català">
				<img src="/ca.png" alt="Català" width="32" height="32" />
			</a>
			<a href={`/es${pathWithoutLocale}`} class:list={[{ active: currentLocale === 'es' }]} title="Castellà">
				<img src="/es.png" alt="Castellà" width="32" height="32" />
			</a>
			<a href={`/en${pathWithoutLocale}`} class:list={[{ active: currentLocale === 'en' }]} title="English">
				<img src="/en.png" alt="English" width="32" height="32" />
			</a>
		</div>
	</nav>
</header>

<style>
	/* Estils generals del header */
	header {
		margin: 0;
		padding: 0 1em;
		background: rgba(0, 0, 0, 0.7);
		backdrop-filter: blur(8px);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a {
		color: white !important;
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a,
	nav button {
		padding: 1em 0.5em;
		color: white !important;
		border-bottom: 4px solid transparent;
		text-decoration: none;
		background: none;
		border: none;
		font: inherit;
		cursor: pointer;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: #4caf50;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.2em;
	}

	/* Selector d'idioma */
	.lang-selector {
		display: flex;
		gap: 0.5em;
		align-items: center;
	}
	.lang-selector a {
		display: inline-block;
		padding: 0.2em;
		border-radius: 50%;
		border: 2px solid transparent;
		transition: border-color 0.2s;
		line-height: 0;
	}
	.lang-selector a.active {
		border-color: #4caf50;
		box-shadow: 0 0 12px rgba(76, 175, 80, 0.4);
	}
	.lang-selector img {
		display: block;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		object-fit: cover;
	}

	/* Estils per als dropdowns */
	.dropdown {
		position: relative;
		display: inline-block;
	}
	.dropbtn {
		background: none;
		border: none;
		font: inherit;
		color: white !important;
		padding: 1em 0.5em;
		cursor: pointer;
	}
	.dropdown-content {
		display: none;
		position: absolute;
		background: rgba(0, 0, 0, 0.9);
		backdrop-filter: blur(8px);
		min-width: 160px;
		box-shadow: 0 8px 16px rgba(0,0,0,0.5);
		z-index: 1;
		top: 100%;
		left: 0;
		border-radius: 4px;
		overflow: hidden;
	}
	.dropdown-content a {
		color: white !important;
		padding: 12px 16px;
		text-decoration: none;
		display: block;
		border-bottom: none;
	}
	.dropdown-content a:hover {
		background-color: rgba(76, 175, 80, 0.3);
	}
	.dropdown:hover .dropdown-content,
	.dropdown:focus-within .dropdown-content {
		display: block;
	}

	/* Responsive */
	@media (max-width: 920px) {
		.internal-links {
			flex-wrap: wrap;
			gap: 0;
		}
		nav a,
		nav button {
			padding: 0.8em 0.3em;
			font-size: 0.85rem;
		}
		.lang-selector img {
			width: 28px;
			height: 28px;
		}
	}
	@media (max-width: 720px) {
		.internal-links a:not(.dropdown) {
			display: none;
		}
		.dropdown .dropbtn {
			padding: 0.8em 0.3em;
			font-size: 0.85rem;
		}
		.lang-selector img {
			width: 24px;
			height: 24px;
		}
	}
</style>

<script>
	// Gestió de clic per als dropdowns (mòbils)
	document.querySelectorAll('.dropdown').forEach(dropdown => {
		const button = dropdown.querySelector('.dropbtn');
		const content = dropdown.querySelector('.dropdown-content');

		button.addEventListener('click', (e) => {
			e.stopPropagation();
			const isOpen = dropdown.classList.contains('open');
			document.querySelectorAll('.dropdown.open').forEach(d => d.classList.remove('open'));
			if (!isOpen) {
				dropdown.classList.add('open');
				button.setAttribute('aria-expanded', 'true');
			} else {
				button.setAttribute('aria-expanded', 'false');
			}
		});

		document.addEventListener('click', () => {
			dropdown.classList.remove('open');
			button.setAttribute('aria-expanded', 'false');
		});
	});
</script>

<style is:global>
	.dropdown.open .dropdown-content {
		display: block;
	}
</style>