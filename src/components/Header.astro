---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

// Idiomes: l'actual (per defecte 'ca') 
const currentLocale = Astro.currentLocale || 'ca';
const basePath = `/${currentLocale}`;

// Obtenim la ruta sense el prefix de l'idioma per poder canviar d'idioma
const pathWithoutLocale = Astro.url.pathname.replace(/^\/[a-z]{2}/, '');
// Si estem a l'arrel (només '/'), pathWithoutLocale serà ''; llavors l'enllaç per a cada idioma serà simplement '/ca', '/es', '/en'
// Per a la resta, construïm l'enllaç com /ca/path, /es/path, etc.
---

<header>
	<nav>
		<h2><a href={basePath}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={basePath}>Inici</HeaderLink>
			<HeaderLink href={`${basePath}/blog`}>Blog</HeaderLink>
			<HeaderLink href={`${basePath}/about`}>Sobre nosaltres</HeaderLink>

			<!-- Menú desplegable: Legal -->
			<div class="dropdown">
				<button class="dropbtn" aria-haspopup="true" aria-expanded="false">
					Legal ▾
				</button>
				<div class="dropdown-content" role="menu">
					<a href={`${basePath}/legal/privacyPolicy`} role="menuitem">Privacitat</a>
					<a href={`${basePath}/legal/legalNotice`} role="menuitem">Avís Legal</a>
					<a href={`${basePath}/legal/termsOfUse`} role="menuitem">Termes</a>
				</div>
			</div>

			<!-- Menú desplegable: Ajuda -->
			<div class="dropdown">
				<button class="dropbtn" aria-haspopup="true" aria-expanded="false">
					Ajuda ▾
				</button>
				<div class="dropdown-content" role="menu">
					<a href={`${basePath}/help/home_page`} role="menuitem">Inici</a>
					<a href={`${basePath}/help/attend_match`} role="menuitem">Assistència</a>
					<a href={`${basePath}/help/progress_page`} role="menuitem">Progrés</a>
				</div>
			</div>
		</div>

		<!-- Selector d'idioma -->
		<div class="lang-selector">
			<a href={`/ca${pathWithoutLocale}`} class:list={[{ active: currentLocale === 'ca' }]}>CA</a>
			<a href={`/es${pathWithoutLocale}`} class:list={[{ active: currentLocale === 'es' }]}>ES</a>
			<a href={`/en${pathWithoutLocale}`} class:list={[{ active: currentLocale === 'en' }]}>EN</a>
		</div>
	</nav>
</header>

<style>
	/* Estils generals del header (els mateixos que tenies) */
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a,
	nav button {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		background: none;
		border: none;
		font: inherit;
		cursor: pointer;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}

	/* Estils per al selector d'idioma */
	.lang-selector {
		display: flex;
		gap: 0.3em;
	}
	.lang-selector a {
		padding: 0.3em 0.6em;
		border-radius: 4px;
		border: 1px solid #ccc;
		text-decoration: none;
		color: var(--black);
		font-size: 0.8em;
		font-weight: bold;
	}
	.lang-selector a.active {
		background-color: var(--accent);
		color: white;
		border-color: var(--accent);
	}
	.lang-selector a:hover {
		background-color: #f0f0f0;
	}
	.lang-selector a.active:hover {
		background-color: var(--accent);
	}

	/* Estils per als dropdowns (no canviem res) */
	.dropdown {
		position: relative;
		display: inline-block;
	}
	.dropbtn {
		background: none;
		border: none;
		font: inherit;
		color: var(--black);
		padding: 1em 0.5em;
		cursor: pointer;
	}
	.dropdown-content {
		display: none;
		position: absolute;
		background-color: white;
		min-width: 160px;
		box-shadow: 0 8px 16px rgba(0,0,0,0.2);
		z-index: 1;
		top: 100%;
		left: 0;
		border-radius: 4px;
		overflow: hidden;
	}
	.dropdown-content a {
		color: var(--black);
		padding: 12px 16px;
		text-decoration: none;
		display: block;
		border-bottom: none;
	}
	.dropdown-content a:hover {
		background-color: #f1f1f1;
	}
	.dropdown:hover .dropdown-content,
	.dropdown:focus-within .dropdown-content {
		display: block;
	}

	/* Responsive: en mòbils, podríem ocultar el selector si cal */
	@media (max-width: 720px) {
		.lang-selector {
			gap: 0.2em;
		}
		.lang-selector a {
			font-size: 0.7em;
			padding: 0.2em 0.4em;
		}
	}
</style>

<script>
	// Gestió de clic per als dropdowns (mòbils)
	document.querySelectorAll('.dropdown').forEach(dropdown => {
		const button = dropdown.querySelector('.dropbtn');
		const content = dropdown.querySelector('.dropdown-content');

		button.addEventListener('click', (e) => {
			e.stopPropagation();
			const isOpen = dropdown.classList.contains('open');
			document.querySelectorAll('.dropdown.open').forEach(d => d.classList.remove('open'));
			if (!isOpen) {
				dropdown.classList.add('open');
				button.setAttribute('aria-expanded', 'true');
			} else {
				button.setAttribute('aria-expanded', 'false');
			}
		});

		document.addEventListener('click', () => {
			dropdown.classList.remove('open');
			button.setAttribute('aria-expanded', 'false');
		});
	});
</script>

<style is:global>
	.dropdown.open .dropdown-content {
		display: block;
	}
</style>