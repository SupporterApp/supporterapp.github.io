---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { useTranslations } from '../i18n/ui';

// Idiomes: l'actual (per defecte 'ca')
const currentLocale = (Astro.currentLocale as keyof typeof ui) || 'ca';
const basePath = `/${currentLocale}`;
const t = useTranslations(currentLocale);

// Obtenim la ruta sense el prefix de l'idioma
const pathWithoutLocale = Astro.url.pathname.replace(/^\/[a-z]{2}/, '');
---

<header>
	<nav>
		<h2>
			<a href={basePath}>
			<img src="/fans.png" alt="Ffans" width="32" height="32" style="vertical-align: middle; margin-right: 0.5rem; border-radius: 50%;" />
			{SITE_TITLE}
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href={basePath}>{t('nav.home')}</HeaderLink>
			<HeaderLink href={`${basePath}/blog`}>{t('nav.blog')}</HeaderLink>
			<HeaderLink href={`${basePath}/about`}>{t('nav.about')}</HeaderLink>

			<!-- Menú desplegable: Legal -->
			<div class="dropdown">
				<button class="dropbtn" aria-haspopup="true" aria-expanded="false">
					{t('nav.legal')} ▾
				</button>
				<div class="dropdown-content" role="menu">
					<a href={`${basePath}/legal/privacyPolicy`} role="menuitem">{t('legal.privacy')}</a>
					<a href={`${basePath}/legal/legalNotice`} role="menuitem">{t('legal.notice')}</a>
					<a href={`${basePath}/legal/termsOfUse`} role="menuitem">{t('legal.terms')}</a>
				</div>
			</div>

			<!-- Menú desplegable: Ajuda -->
			<div class="dropdown">
				<button class="dropbtn" aria-haspopup="true" aria-expanded="false">
					{t('nav.help')} ▾
				</button>
				<div class="dropdown-content" role="menu">
					<a href={`${basePath}/help/home_page`} role="menuitem">{t('help.home')}</a>
					<a href={`${basePath}/help/attend_match`} role="menuitem">{t('help.attend')}</a>
					<a href={`${basePath}/help/progress_page`} role="menuitem">{t('help.progress')}</a>
				</div>
			</div>
		</div>

		<!-- Theme toggle -->
		<button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle dark/light mode">
			<span class="theme-icon">🌙</span>
		</button>

		<!-- Selector d'idioma amb banderes PNG -->
		<div class="lang-selector">
			<a href={`/ca${pathWithoutLocale}`} class:list={[{ active: currentLocale === 'ca' }]} title="Català">
				<img src="/ca.png" alt="Català" width="32" height="32" />
			</a>
			<a href={`/es${pathWithoutLocale}`} class:list={[{ active: currentLocale === 'es' }]} title="Castellà">
				<img src="/es.png" alt="Castellà" width="32" height="32" />
			</a>
			<a href={`/en${pathWithoutLocale}`} class:list={[{ active: currentLocale === 'en' }]} title="English">
				<img src="/en.png" alt="English" width="32" height="32" />
			</a>
		</div>
	</nav>
</header>

<style>
	/* Estils generals del header */
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--header-bg);
		backdrop-filter: blur(8px);
		box-shadow: 0 2px 8px var(--header-shadow);
		position: relative;
		z-index: 100;
		transition: background 0.3s, box-shadow 0.3s;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a {
		color: var(--text) !important;
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.3rem;
	}
	nav a,
	nav button {
		padding: 1em 0.5em;
		color: var(--text) !important;
		border-bottom: 4px solid transparent;
		text-decoration: none;
		background: none;
		border: none;
		font: inherit;
		cursor: pointer;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: #4caf50;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.2em;
		flex-wrap: wrap;
	}

	/* Selector d'idioma */
	.lang-selector {
		display: flex;
		gap: 0.5em;
		align-items: center;
	}
	.lang-selector a {
		display: inline-block;
		padding: 0.2em;
		border-radius: 50%;
		border: 2px solid transparent;
		transition: border-color 0.2s;
		line-height: 0;
	}
	.lang-selector a.active {
		border-color: #4caf50;
		box-shadow: 0 0 12px rgba(76, 175, 80, 0.4);
	}
	.lang-selector img {
		display: block;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		object-fit: cover;
	}

	/* Estils per als dropdowns */
	.dropdown {
		position: relative;
		display: inline-block;
		z-index: 100;
	}
	.dropbtn {
		background: none;
		border: none;
		font: inherit;
		color: var(--text) !important;
		padding: 1em 0.5em;
		cursor: pointer;
	}
	.dropdown-content {
		display: none;
		position: absolute;
		background: var(--dropdown-bg);
		backdrop-filter: blur(8px);
		min-width: 160px;
		box-shadow: 0 8px 16px var(--header-shadow);
		z-index: 1000;
		top: 100%;
		left: 0;
		border-radius: 4px;
		overflow: hidden;
	}
	.dropdown-content a {
		color: var(--text) !important;
		padding: 12px 16px;
		text-decoration: none;
		display: block;
		border-bottom: none;
	}
	.dropdown-content a:hover {
		background-color: var(--dropdown-hover);
	}
	.theme-toggle {
		background: none;
		border: 2px solid var(--text);
		border-radius: 20px;
		padding: 0.25em 0.6em;
		cursor: pointer;
		font-size: 1rem;
		line-height: 1;
		color: var(--text);
		transition: border-color 0.2s, opacity 0.2s;
		opacity: 0.75;
	}
	.theme-toggle:hover {
		opacity: 1;
	}
	.dropdown:hover .dropdown-content,
	.dropdown:focus-within .dropdown-content {
		display: block;
	}

	/* Responsive: pantalles mitjanes */
	@media (max-width: 920px) {
		.internal-links {
			flex-wrap: wrap;
			gap: 0;
		}
		nav a,
		nav button {
			padding: 0.8em 0.3em;
			font-size: 0.85rem;
		}
		.lang-selector img {
			width: 28px;
			height: 28px;
		}
	}

	/* Responsive: pantalles petites (mòbil) - FORMAT COMPACTE */
	@media (max-width: 720px) {
		/* Tots els enllaços visibles, en línia i compactes */
		.internal-links {
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.2rem;
		}
		.internal-links a:not(.dropdown) {
			display: inline-block;
			font-size: 0.75rem;
			padding: 0.4rem 0.3rem;
		}
		.dropdown .dropbtn {
			font-size: 0.75rem;
			padding: 0.4rem 0.3rem;
		}
		.lang-selector img {
			width: 24px;
			height: 24px;
		}
		header {
			padding: 0 0.5em;
		}
		nav {
			gap: 0.3rem;
		}
	}
</style>

<script>
	// Theme toggle
	const btn = document.getElementById('theme-toggle');
	const icon = btn.querySelector('.theme-icon');
	function applyTheme(dark) {
		document.body.classList.toggle('dark', dark);
		icon.textContent = dark ? '☀️' : '🌙';
		localStorage.setItem('theme', dark ? 'dark' : 'light');
	}
	// Init icon from current state
	applyTheme(document.body.classList.contains('dark'));
	btn.addEventListener('click', () => applyTheme(!document.body.classList.contains('dark')));

	// Dropdown management
	document.querySelectorAll('.dropdown').forEach(dropdown => {
		const button = dropdown.querySelector('.dropbtn');
		const content = dropdown.querySelector('.dropdown-content');

		button.addEventListener('click', (e) => {
			e.stopPropagation();
			const isOpen = dropdown.classList.contains('open');
			document.querySelectorAll('.dropdown.open').forEach(d => d.classList.remove('open'));
			if (!isOpen) {
				dropdown.classList.add('open');
				button.setAttribute('aria-expanded', 'true');
			} else {
				button.setAttribute('aria-expanded', 'false');
			}
		});

		document.addEventListener('click', () => {
			dropdown.classList.remove('open');
			button.setAttribute('aria-expanded', 'false');
		});
	});
</script>

<style is:global>
	.dropdown.open .dropdown-content {
		display: block;
	}
</style>