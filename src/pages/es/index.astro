---
import Layout from '../../layouts/Layout.astro';
import TeamScores from '../../components/TeamScores.astro';
---

<Layout title="Ffans - Fans del Fútbol">
  <div class="hero">
    <h1 class="main-title">Ffans: Fans del Fútbol</h1>
    <p class="subtitle">Eres el alma del fútbol. Ahora tienes tu propia puntuación.</p>
    <p class="highlight">Nunca se había medido la pasión de los aficionados. Hasta ahora.</p>
    <p class="description">
      Ffans es la primera aplicación que te pone a ti, el aficionado, en el centro del espectáculo.
      No hay resultados ni fichajes. Solo hay personas como tú, que viven el fútbol con intensidad.
    </p>
  </div>

  <TeamScores lang="es" />
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 40vh;
    text-align: center;
    padding-bottom: 1rem;
  }
  .main-title {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    color: var(--text);
    text-shadow: 0 2px 8px var(--hero-title-shadow);
  }
  .subtitle {
    font-size: 1.8rem;
    font-weight: 300;
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  .highlight {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--highlight);
    margin-bottom: 1.5rem;
  }
  .description {
    font-size: 1.2rem;
    line-height: 1.8;
    max-width: 700px;
    margin: 0 auto;
    color: var(--text);
  }
  @media (max-width: 720px) {
    .hero {
      min-height: 30vh;
    }
    .main-title {
      font-size: 2.2rem;
    }
    .subtitle {
      font-size: 1.2rem;
    }
  }
</style>
