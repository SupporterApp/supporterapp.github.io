---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../../consts';

// Carreguem només els posts de la carpeta 'es/'
const allPosts = await getCollection('blog', ({ id }) => id.startsWith('es/'));
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title={`Blog - ${SITE_TITLE}`}
  description="Novedades, guías e historias de la comunidad Ffans."
>
  <h1 class="page-title">Blog</h1>
  <style>
    /* Manté els mateixos estils que tenies */
    .blog-list {
      padding: 1rem 0;
    }
    .page-title {
      margin: 0 0 1.5rem;
      font-size: clamp(2rem, 4vw, 2.6rem);
      color: var(--text);
    }
    .blog-list ul {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      list-style-type: none;
      margin: 0;
      padding: 0;
    }
    .blog-list ul li {
      width: calc(50% - 1rem);
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1.5rem;
      box-shadow: 0 4px 16px var(--card-shadow);
      transition: transform 0.2s, box-shadow 0.2s, background 0.3s, border-color 0.2s;
    }
    .blog-list ul li:hover {
      transform: scale(1.02);
      border-color: var(--accent);
      box-shadow: 0 8px 24px var(--card-shadow-hover);
    }
    .blog-list ul li:first-child {
      width: 100%;
      margin-bottom: 1rem;
      text-align: center;
    }
    .blog-list ul li:first-child img {
      width: 100%;
    }
    .blog-list ul li:first-child .title {
      font-size: 2.369rem;
    }
    .blog-list ul li img {
      display: block;
      width: 100%;
      /* Una mica més baixa que la imatge original (2:1) perquè la targeta no
         quedi tan alta; es retalla per dalt i es conserva la barra de sota. */
      aspect-ratio: 2.2 / 1;
      height: auto;
      object-fit: cover;
      object-position: center bottom;
      margin-bottom: 0.5rem;
      border-radius: 12px;
    }
    .blog-list ul li a {
      display: block;
      color: var(--text) !important;
      text-decoration: none;
    }
    .blog-list .title {
      margin: 0;
      color: var(--text) !important;
      line-height: 1.2;
    }
    .blog-list .date {
      margin: 0.5rem 0 0 0;
      color: var(--text-subtle) !important;
      font-size: 0.9rem;
    }
    .blog-list ul li a:hover h4,
    .blog-list ul li a:hover .date {
      color: var(--accent) !important;
    }
    .blog-list ul a:hover img {
      box-shadow: 0 8px 20px var(--card-shadow);
    }
    @media (max-width: 720px) {
      .blog-list ul {
        gap: 0.5em;
      }
      .blog-list ul li {
        width: 100%;
        text-align: center;
      }
      .blog-list ul li:first-child {
        margin-bottom: 0;
      }
      .blog-list ul li:first-child .title {
        font-size: 1.563em;
      }
    }
  </style>

  <div class="blog-list">
    <ul>
      {
        posts.map((post) => {
          // Extraiem l'slug sense el prefix 'es/'
          const slug = post.id.replace(/^es\//, '');
          return (
            <li>
              <a href={`/es/blog/${slug}/`}>
                {post.data.heroImage && (
                  <Image width={720} height={360} src={post.data.heroImage} alt="" />
                )}
                <h4 class="title">{post.data.title}</h4>
                <p class="date">
                  <FormattedDate date={post.data.pubDate} />
                </p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</Layout>