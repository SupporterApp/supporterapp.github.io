---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="About us - Ffans">
  <div class="about-container">
    <h1>About us</h1>
    <p>A group of friends passionate about technology and football</p>
  </div>
</Layout>

<style>
  .about-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 50vh;
    text-align: center;
  }
  h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  p {
    font-size: 1.5rem;
    font-weight: 300;
  }
</style>