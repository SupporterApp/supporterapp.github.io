---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../../layouts/DocLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs', ({ data }) => data.section === 'help');
  return entries.map((entry) => {
    const lang = entry.id.split('/')[0];
    // `entry.data.route` conserva les majúscules; `entry.id` no.
    return { params: { lang, slug: entry.data.route }, props: { entry, lang } };
  });
}

const { entry, lang } = Astro.props;
const { Content } = await render(entry);
---

<DocLayout title={entry.data.title} description={entry.data.description} lang={lang}>
  <Content />
</DocLayout>
