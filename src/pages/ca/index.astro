---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Ffans - Fans del Futbol">
  <div class="hero">
    <h1 class="main-title">Ffans: Fans del Futbol</h1>
    <p class="subtitle">Ets l'ànima del futbol. Ara tens la teva pròpia puntuació.</p>
    <p class="highlight">Mai s'havia mesurat la passió dels aficionats. Fins ara.</p>
    <p class="description">
      Ffans és la primera aplicació que et posa a tu, l'aficionat, al centre de l'espectacle. 
      No hi ha resultats ni fitxatges. Només hi ha persones com tu, que viuen el futbol amb intensitat.
    </p>
  </div>
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
  }
  .main-title {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    color: var(--text);
    text-shadow: 0 2px 8px var(--hero-title-shadow);
  }
  .subtitle {
    font-size: 1.8rem;
    font-weight: 300;
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  .highlight {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--highlight);
    margin-bottom: 1.5rem;
  }
  .description {
    font-size: 1.2rem;
    line-height: 1.8;
    max-width: 700px;
    margin: 0 auto;
    color: var(--text);
  }
  @media (max-width: 720px) {
    .main-title {
      font-size: 2.2rem;
    }
    .subtitle {
      font-size: 1.2rem;
    }
  }
</style>