---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title={`Blog - ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<style>
		/* Ajustos específics per a la llista del blog */
		.blog-list {
			padding: 1rem 0;
		}
		.blog-list ul {
			display: flex;
			flex-wrap: wrap;
			gap: 2rem;
			list-style-type: none;
			margin: 0;
			padding: 0;
		}
		.blog-list ul li {
			width: calc(50% - 1rem);
			background: rgba(0, 0, 0, 0.5);
			border-radius: 12px;
			padding: 1.5rem;
			backdrop-filter: blur(4px);
			transition: transform 0.2s;
		}
		.blog-list ul li:hover {
			transform: scale(1.02);
		}
		.blog-list ul li:first-child {
			width: 100%;
			margin-bottom: 1rem;
			text-align: center;
		}
		.blog-list ul li:first-child img {
			width: 100%;
		}
		.blog-list ul li:first-child .title {
			font-size: 2.369rem;
		}
		.blog-list ul li img {
			margin-bottom: 0.5rem;
			border-radius: 12px;
		}
		.blog-list ul li a {
			display: block;
			color: white !important;
			text-decoration: none;
		}
		.blog-list .title {
			margin: 0;
			color: white !important;
			line-height: 1.2;
		}
		.blog-list .date {
			margin: 0.5rem 0 0 0;
			color: #cccccc !important;
			font-size: 0.9rem;
		}
		.blog-list ul li a:hover h4,
		.blog-list ul li a:hover .date {
			color: #4caf50 !important;
		}
		.blog-list ul a:hover img {
			box-shadow: 0 8px 20px rgba(0,0,0,0.4);
		}
		@media (max-width: 720px) {
			.blog-list ul {
				gap: 0.5em;
			}
			.blog-list ul li {
				width: 100%;
				text-align: center;
			}
			.blog-list ul li:first-child {
				margin-bottom: 0;
			}
			.blog-list ul li:first-child .title {
				font-size: 1.563em;
			}
		}
	</style>

	<div class="blog-list">
		<ul>
			{
				posts.map((post) => (
					<li>
						<a href={`/ca/blog/${post.id}/`}>
							{post.data.heroImage && (
								<Image width={720} height={360} src={post.data.heroImage} alt="" />
							)}
							<h4 class="title">{post.data.title}</h4>
							<p class="date">
								<FormattedDate date={post.data.pubDate} />
							</p>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</Layout>