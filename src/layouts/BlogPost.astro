---
// src/layouts/BlogPost.astro
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro'; // Important: utilitza el teu Layout principal
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} - ${SITE_TITLE}`} description={description}>
  <article class="blog-post">
    {heroImage && (
      <div class="hero-image">
        <Image width={1020} height={510} src={heroImage} alt="" />
      </div>
    )}
    <div class="content">
      <header>
        <h1>{title}</h1>
        <div class="date">
          <FormattedDate date={pubDate} />
          {updatedDate && (
            <div class="last-updated-on">
              Darrera actualització: <FormattedDate date={updatedDate} />
            </div>
          )}
        </div>
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Layout>

<style>
  .blog-post {
    max-width: 720px;
    margin: 0 auto;
    padding: 1.5rem;
    background: rgba(0, 0, 0, 0.7);
    border-radius: 12px;
    backdrop-filter: blur(8px);
    color: white;
  }
  .blog-post h1 {
    font-size: 2.5rem;
    color: white;
    margin-bottom: 0.5rem;
  }
  .blog-post .date {
    color: #ccc;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }
  .blog-post .last-updated-on {
    font-style: italic;
    margin-top: 0.2rem;
    color: #aaa;
  }
  .blog-post .prose {
    line-height: 1.8;
  }
  .blog-post .prose p {
    margin: 1rem 0;
  }
  .blog-post .prose a {
    color: #4caf50;
  }
  .blog-post .prose img {
    max-width: 100%;
    border-radius: 8px;
  }
  .blog-post .hero-image {
    margin-bottom: 1.5rem;
  }
  .blog-post .hero-image img {
    border-radius: 12px;
    width: 100%;
  }
  @media (max-width: 720px) {
    .blog-post {
      padding: 1rem;
    }
    .blog-post h1 {
      font-size: 1.8rem;
    }
  }
</style>