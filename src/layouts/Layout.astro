---
// src/layouts/Layout.astro
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
}

const { title, description, image, lang = 'ca' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} />
    <script is:inline>
      if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark-pending');
    </script>
    <style is:global>
      /* ── Theme tokens ── */
      :root {
        --overlay-bg:        rgba(255, 255, 255, 0.75);
        --text:              #1a1a2e;
        --text-muted:        #555;
        --text-subtle:       #666;
        --accent:            #2e7d32;
        --accent-hover:      #1b5e20;
        --header-bg:         rgba(255, 255, 255, 0.85);
        --header-shadow:     rgba(0, 0, 0, 0.15);
        --dropdown-bg:       rgba(255, 255, 255, 0.95);
        --dropdown-hover:    rgba(46, 125, 50, 0.15);
        --footer-bg:         rgba(255, 255, 255, 0.85);
        --footer-border:     rgba(0, 0, 0, 0.1);
        --card-bg:           rgba(255, 255, 255, 0.9);
        --card-shadow:       rgba(0, 0, 0, 0.12);
        --card-shadow-hover: rgba(0, 0, 0, 0.18);
        --hero-title-shadow: rgba(255, 255, 255, 0.6);
        --highlight:         #1b5e20;
        --webview-overlay:   rgba(255, 255, 255, 0.85);
      }
      body.dark {
        --overlay-bg:        rgba(0, 0, 0, 0.65);
        --text:              #f0f0f0;
        --text-muted:        #ccc;
        --text-subtle:       #aaa;
        --accent:            #4caf50;
        --accent-hover:      #81c784;
        --header-bg:         rgba(0, 0, 0, 0.75);
        --header-shadow:     rgba(0, 0, 0, 0.4);
        --dropdown-bg:       rgba(20, 20, 30, 0.97);
        --dropdown-hover:    rgba(76, 175, 80, 0.25);
        --footer-bg:         rgba(0, 0, 0, 0.8);
        --footer-border:     rgba(255, 255, 255, 0.1);
        --card-bg:           rgba(0, 0, 0, 0.55);
        --card-shadow:       rgba(0, 0, 0, 0.35);
        --card-shadow-hover: rgba(0, 0, 0, 0.5);
        --hero-title-shadow: rgba(0, 0, 0, 0.8);
        --highlight:         #ffb74d;
        --webview-overlay:   rgba(0, 0, 0, 0.75);
      }

      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background-image: url('/FootballFans.webp');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        overflow-x: hidden;
        width: 100%;
        max-width: 100%;
      }
      * {
        box-sizing: border-box;
      }
      .overlay {
        background-color: var(--overlay-bg);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        transition: background-color 0.3s;
      }
      main {
        flex: 1;
        padding: 2rem 1.5rem;
        max-width: 900px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
      }
      h1, h2, h3, p {
        color: var(--text);
      }
      a {
        color: var(--accent);
      }

      body.webview .overlay {
        background-color: var(--webview-overlay);
      }
      body.webview main {
        padding-top: 1rem;
        padding-bottom: 1rem;
      }
      body.webview header,
      body.webview footer {
        display: none !important;
      }

      img, iframe, video, .doc-card, .blog-post, .help-container {
        max-width: 100%;
        height: auto;
      }
    </style>
  </head>
  <body>
    <div class="overlay">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      if (localStorage.getItem('theme') === 'dark') document.body.classList.add('dark');
      (function() {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('webview')) {
          document.body.classList.add('webview');
          const header = document.querySelector('header');
          const footer = document.querySelector('footer');
          if (header) header.style.display = 'none';
          if (footer) footer.style.display = 'none';
        }
      })();
    </script>
  </body>
</html>