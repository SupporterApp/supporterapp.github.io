---
// src/layouts/Layout.astro
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
}

const { title, description, image, lang = 'ca' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} />
    <style is:global>
      /* Estils globals per al fons */
      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background-image: url('/FootballFans.webp');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        color: white;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      .overlay {
        background-color: rgba(0, 0, 0, 0.6); /* Capa fosca per a llegibilitat */
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      main {
        flex: 1;
        padding: 2rem 1.5rem;
        max-width: 900px;
        margin: 0 auto;
        width: 100%;
      }
      h1, h2, h3, p {
        color: white;
      }
      a {
        color: #4caf50;
      }
    </style>
  </head>
  <body>
    <div class="overlay">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>