---
// src/layouts/Layout.astro
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
}

const { title, description, image, lang = 'ca' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} />
    <style is:global>
      /* Estils globals per al fons */
      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background-image: url('/FootballFans.webp');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        color: white;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        overflow-x: hidden;
        width: 100%;
        max-width: 100%;
      }
      * {
        box-sizing: border-box;
      }
      .overlay {
        background-color: rgba(0, 0, 0, 0.6);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      main {
        flex: 1;
        padding: 2rem 1.5rem;
        max-width: 900px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
      }
      h1, h2, h3, p {
        color: white;
      }
      a {
        color: #4caf50;
      }

      /* Estils per a webview (quan el body té la classe .webview) */
      body.webview .overlay {
        background-color: rgba(0, 0, 0, 0.7);
      }
      body.webview main {
        padding-top: 1rem;
        padding-bottom: 1rem;
      }
      body.webview header,
      body.webview footer {
        display: none !important;
      }

      /* Evitar scroll horitzontal */
      img, iframe, video, .doc-card, .blog-post, .help-container {
        max-width: 100%;
        height: auto;
      }
    </style>
  </head>
  <body>
    <div class="overlay">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    <!-- DETECCIÓ DE WEBVIEW AL CLIENT (JavaScript) -->
    <script>
      (function() {
        // Comprovar si la URL conté ?webview=true
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('webview')) {
          // Afegir classe webview al body
          document.body.classList.add('webview');
          
          // Ocultar header i footer (per si el CSS no ho fa)
          const header = document.querySelector('header');
          const footer = document.querySelector('footer');
          if (header) header.style.display = 'none';
          if (footer) footer.style.display = 'none';
        }
      })();
    </script>
  </body>
</html>