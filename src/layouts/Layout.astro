---
// src/layouts/Layout.astro
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
}

const { title, description, image, lang = 'ca' } = Astro.props;

// Detectem si la pàgina es veu en webview (paràmetre ?webview=true)
const isWebview = Astro.url.searchParams.has('webview');
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} />
    <style is:global>
      /* Estils globals per al fons */
      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background-image: url('/FootballFans.webp');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        color: white;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      .overlay {
        background-color: rgba(0, 0, 0, 0.6);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      main {
        flex: 1;
        padding: 2rem 1.5rem;
        max-width: 900px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
      }
      h1, h2, h3, p {
        color: white;
      }
      a {
        color: #4caf50;
      }

      /* Ajust per a webview: eliminar padding extra i ocultar header/footer */
      body.webview .overlay {
        background-color: rgba(0, 0, 0, 0.7); /* Una mica més fosc per a llegibilitat */
      }
      body.webview main {
        padding-top: 1rem;
        padding-bottom: 1rem;
      }
      body.webview header,
      body.webview footer {
        display: none !important;
      }
    </style>
  </head>
  <body class={isWebview ? 'webview' : ''}>
    <div class="overlay">
      {!isWebview && <Header />}
      <main>
        <slot />
      </main>
      {!isWebview && <Footer />}
    </div>
  </body>
</html>